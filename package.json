{
  "name": "vitepress-chat",
  "version": "0.0.1",
  "description": "Easily add AI chat with knowledge on your site and live streaming results from a secure proxy server.",
  "keywords": [
    "vitepress-plugin",
    "vitepress",
    "plugin",
    "chat"
  ],
  "homepage": "https://cssnr.github.io/vitepress-chat/",
  "bugs": {
    "url": "https://github.com/cssnr/vitepress-chat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cssnr/vitepress-chat.git"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/cssnr"
  },
  "license": "MIT",
  "author": {
    "name": "Shane",
    "url": "https://cssnr.github.io/"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/chat.es.js",
      "types": "./dist/index.d.ts"
    },
    "./instructions": {
      "import": "./dist/instructions.es.js",
      "types": "./dist/instructions.d.ts"
    },
    "./style.css": "./dist/vitepress-chat.css"
  },
  "main": "dist/chat.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly",
    "docs": "npm run docs:dev",
    "docs:build": "vitepress build docs",
    "docs:clean": "rm -rf docs/.vitepress/cache docs/.vitepress/dist",
    "docs:deploy": "npm run docs:build",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "lint": "npx eslint src",
    "prepare": "npm run build",
    "prettier": "npm run prettier:write",
    "prettier:check": "npx prettier --check .",
    "prettier:write": "npx prettier --write .",
    "tsc": "npx tsc --noEmit"
  },
  "devDependencies": {
    "@ai-sdk/vue": "^4.0.77",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "ai": "^7.0.77",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "highlight.js": "^11.12.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.10",
    "marked-highlight": "^2.2.4",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitepress": "next",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "@ai-sdk/vue": ">=3.0.0",
    "ai": ">=6.0.0",
    "highlight.js": ">=11.0.0",
    "marked": ">=18.0.0",
    "marked-highlight": ">=2.0.0",
    "vitepress": "*",
    "vue": ">=3.0.0"
  }
}
